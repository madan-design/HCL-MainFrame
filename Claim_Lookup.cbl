       IDENTIFICATION DIVISION.
       PROGRAM-ID. CLAIM-LOOKUP.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT POLICY-FILE ASSIGN TO "POLICY.DAT"
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS POLICY-KEY
               FILE STATUS IS POLICY-STATUS.
           SELECT SUSPENSE-FILE ASSIGN TO "SUSPENSE.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD POLICY-FILE.
       01 POLICY-RECORD.
          05 POLICY-KEY PIC X(10).
       FD SUSPENSE-FILE.
       01 SUSPENSE-RECORD PIC X(80).
       WORKING-STORAGE SECTION.
       01 POLICY-STATUS PIC XX.
       01 CLAIM-ID      PIC X(7) VALUE "CLM9981".
       01 CLAIM-POLICY  PIC X(10) VALUE "POL-778899".
       01 CLAIM-AMOUNT  PIC Z(3)9.99 VALUE 1500.00.
       01 SUSPENSE-COUNT PIC 9(5) VALUE ZERO.
       PROCEDURE DIVISION.
           OPEN INPUT POLICY-FILE
           OPEN OUTPUT SUSPENSE-FILE
           MOVE CLAIM-POLICY TO POLICY-KEY
           READ POLICY-FILE
           EVALUATE POLICY-STATUS
             WHEN "00"
               DISPLAY "Policy found; adjudicate claim"
             WHEN "23"
               ADD 1 TO SUSPENSE-COUNT
               STRING CLAIM-ID "|" CLAIM-POLICY "|"
                   CLAIM-AMOUNT "|ERR23-POLICY-NOT-FOUND"
                   INTO SUSPENSE-RECORD
               END-STRING
               WRITE SUSPENSE-RECORD
             WHEN OTHER
               DISPLAY "Policy file error: " POLICY-STATUS
               MOVE 1 TO RETURN-CODE
           END-EVALUATE
           CLOSE POLICY-FILE SUSPENSE-FILE
           STOP RUN.
