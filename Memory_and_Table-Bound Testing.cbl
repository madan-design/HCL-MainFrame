IDENTIFICATION DIVISION.
PROGRAM-ID. TABLE-BOUND-TEST.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-TEST-COUNT          PIC 9(7) COMP-5.
01 WS-TEST-CAPACITY       PIC 9(7) COMP-5.
01 WS-INDEX               PIC 9(7) COMP-5.
01 WS-ACCOUNT-ID          PIC 9(6) COMP-5.
01 WS-TOTAL               PIC 9(12) COMP-5.
01 WS-EXPECTED-TOTAL      PIC 9(12) COMP-5.
01 WS-START-TICKS         PIC 9(9) COMP-5.
01 WS-END-TICKS           PIC 9(9) COMP-5.
01 WS-ELAPSED-CS          PIC S9(9) COMP-5.
01 WS-ELAPSED-SECONDS     PIC 9(7)V99 COMP-3.
01 WS-RATE                PIC 9(12)V99 COMP-3.
01 WS-CURRENT-DATE        PIC X(21).
01 WS-HOURS               PIC 99.
01 WS-MINUTES             PIC 99.
01 WS-SECONDS             PIC 99.
01 WS-HUNDREDTHS          PIC 99.
01 WS-LABEL               PIC X(24).
01 WS-COUNT-EDIT          PIC Z(9)9.
01 WS-TOTAL-EDIT           PIC Z(11)9.
01 WS-SECS-EDIT            PIC Z(6)9.99.
01 WS-RATE-EDIT            PIC Z(9)9.99.
01 WS-TABLE.
   05 WS-TRANSACTION OCCURS 1000000 TIMES.
      10 WS-TABLE-ACCOUNT  PIC 9(6) COMP-5.
      10 WS-TABLE-AMOUNT   PIC 9 COMP-5.

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    DISPLAY "Table capacity and performance tests"

    MOVE "Zero records" TO WS-LABEL
    MOVE 0 TO WS-TEST-COUNT
    MOVE 100 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    MOVE "One record" TO WS-LABEL
    MOVE 1 TO WS-TEST-COUNT
    MOVE 100 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    MOVE "Exact capacity (100)" TO WS-LABEL
    MOVE 100 TO WS-TEST-COUNT
    MOVE 100 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    MOVE "Capacity plus one" TO WS-LABEL
    MOVE 101 TO WS-TEST-COUNT
    MOVE 100 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    MOVE "Performance: 1,000" TO WS-LABEL
    MOVE 1000 TO WS-TEST-COUNT
    MOVE 1000000 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    MOVE "Performance: 10,000" TO WS-LABEL
    MOVE 10000 TO WS-TEST-COUNT
    MOVE 1000000 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    MOVE "Performance: 100,000" TO WS-LABEL
    MOVE 100000 TO WS-TEST-COUNT
    MOVE 1000000 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    MOVE "Performance: 1,000,000" TO WS-LABEL
    MOVE 1000000 TO WS-TEST-COUNT
    MOVE 1000000 TO WS-TEST-CAPACITY
    PERFORM RUN-TEST

    STOP RUN.

RUN-TEST.
    DISPLAY " "
    DISPLAY WS-LABEL
    IF WS-TEST-COUNT > WS-TEST-CAPACITY
        DISPLAY "TABLE CAPACITY EXCEEDED"
    ELSE
        MOVE 0 TO WS-TOTAL
        PERFORM GET-TICKS
        MOVE WS-END-TICKS TO WS-START-TICKS

        PERFORM VARYING WS-INDEX FROM 1 BY 1
            UNTIL WS-INDEX > WS-TEST-COUNT
            COMPUTE WS-ACCOUNT-ID =
                FUNCTION MOD(WS-INDEX - 1, 100) + 1
            MOVE WS-ACCOUNT-ID TO WS-TABLE-ACCOUNT(WS-INDEX)
            MOVE 1 TO WS-TABLE-AMOUNT(WS-INDEX)
            ADD WS-TABLE-AMOUNT(WS-INDEX) TO WS-TOTAL
        END-PERFORM

        PERFORM GET-TICKS
        COMPUTE WS-ELAPSED-CS = WS-END-TICKS - WS-START-TICKS
        IF WS-ELAPSED-CS < 0
            ADD 8640000 TO WS-ELAPSED-CS
        END-IF

        MOVE WS-TEST-COUNT TO WS-EXPECTED-TOTAL
        MOVE WS-TEST-COUNT TO WS-COUNT-EDIT
        MOVE WS-TOTAL TO WS-TOTAL-EDIT
        DISPLAY "Processed: " WS-COUNT-EDIT
        DISPLAY "Total amount: " WS-TOTAL-EDIT
        IF WS-TOTAL = WS-EXPECTED-TOTAL
            DISPLAY "Total check: OK"
        ELSE
            DISPLAY "Total check: FAILED"
        END-IF

        COMPUTE WS-ELAPSED-SECONDS = WS-ELAPSED-CS / 100
        MOVE WS-ELAPSED-SECONDS TO WS-SECS-EDIT
        IF WS-ELAPSED-CS > 0
            COMPUTE WS-RATE =
                WS-TEST-COUNT * 100 / WS-ELAPSED-CS
        ELSE
            MOVE 0 TO WS-RATE
        END-IF
        MOVE WS-RATE TO WS-RATE-EDIT
        DISPLAY "Elapsed seconds: " WS-SECS-EDIT
        DISPLAY "Records per second: " WS-RATE-EDIT
    END-IF.

GET-TICKS.
    MOVE FUNCTION CURRENT-DATE TO WS-CURRENT-DATE
    MOVE WS-CURRENT-DATE(9:2) TO WS-HOURS
    MOVE WS-CURRENT-DATE(11:2) TO WS-MINUTES
    MOVE WS-CURRENT-DATE(13:2) TO WS-SECONDS
    MOVE WS-CURRENT-DATE(15:2) TO WS-HUNDREDTHS
    COMPUTE WS-END-TICKS = WS-HOURS * 360000
        + WS-MINUTES * 6000
        + WS-SECONDS * 100
        + WS-HUNDREDTHS.
